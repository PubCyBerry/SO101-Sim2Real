     def obj_pos(self, name: str) -> torch.Tensor:
         return self.scene[name].data.root_pos_w[0, :3].clone()
 
+    def _obj_yaw(self, name: str) -> float:
+        """큐브 root quaternion(wxyz) 에서 world yaw(rad) — 갭 정렬 진단용."""
+        q = self.scene[name].data.root_quat_w[0]
+        w, x, y, z = (float(q[0]), float(q[1]), float(q[2]), float(q[3]))
+        return math.atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z))
+
     def ee_pos(self) -> torch.Tensor:
         """IK 작업점(grasp 접점)의 현재 world 위치."""
         bp = self.robot.data.body_pos_w[0, self.ee_body_idx]
         bq = self.robot.data.body_quat_w[0, self.ee_body_idx]
         return bp + quat_apply(bq.unsqueeze(0), self.ee_offset.unsqueeze(0)).squeeze(0)
 
+    def _lateral_offset(self) -> torch.Tensor:
+        """비대칭 보정 lateral 벡터(world xy, 길이 grasp_lateral). **gripper-local X 축**의 world
+        투영 방향. 밀림 분해로 확인: 닫을 때 큐브 밀림이 거의 전부 local X 성분(=jaw 회전 호 방향)
+        이고 갭축(local Y)·접근축(local Z) 성분은 미미하다. ee 목표를 이 방향으로 옮기면 큐브가
+        jaw 푸시 시작점 반대(고정 finger 쪽)에 놓여, 닫을 때 jaw 가 큐브를 갭 안으로 눌러 고정한다."""
+        if args.grasp_lateral == 0.0:
+            return torch.zeros(2, device=self.device)
+        gq = self.robot.data.body_quat_w[0, self.ee_body_idx]
+        axis = quat_apply(gq.unsqueeze(0), torch.tensor([[1.0, 0.0, 0.0]], device=self.device)).squeeze(0)
+        v = axis[:2]
+        v = v / (torch.linalg.norm(v) + 1e-6)
+        return v * args.grasp_lateral
+
     # --- 조건 체크 ---
     def reached(self, target_pos_w: torch.Tensor, tol: float) -> bool:
         return torch.linalg.norm(self.ee_pos() - target_pos_w).item() < tol
