# =============================================================================
# env/groot_n15.env — GR00T-N1.5 (LeRobot 네이티브 `groot` wrapper) 모델 프로필
#
# 모델 간 값이 달라지는 변수만 담는다. compose 가 .env 위에 이 파일을 겹쳐 주입한다
# (env_file 리스트, 나중 파일이 override). 활성 프로필은 .env 의 POLICY_PROFILE
# (=groot_n15) 로 고른다.
#
# ■ 경로 — ACT/SmolVLA 와 동일한 단일 policy-server 경로 (ZMQ·convert·modality.json 불필요)
#   N1.5 는 LeRobot 0.5.1 내장 `groot` policy(@register_subclass("groot"))로 동작한다.
#   - 학습   : policy-server train → lerobot-train --policy.type=groot --policy.base_model_path=nvidia/GR00T-N1.5-3B
#   - 추론   : policy-server (gRPC) 단일. vla_policy_node 가 policy_type=groot 로 주입.
#   base 는 Eagle-2.5(Qwen3) backbone + lerobot/eagle2hg-processor-groot-n1p5 토크나이저
#   (GrootConfig 기본값). transformers 5.3 호환은 docker/groot_compat_patch.py 가 빌드 시 처리.
# =============================================================================

# ── lerobot 네이티브 groot (N1.5) ────────────────────────────────────────────
POLICY_TYPE=groot                  # demo_vla.sh 서비스 라우팅 키 (= lerobot policy type)
TRAIN_POLICY_TYPE=groot            # → --policy.type=groot --policy.base_model_path=...
POLICY_BASE_MODEL_PATH=nvidia/GR00T-N1.5-3B
POLICY_TOKENIZER_ASSETS_REPO=      # 비움 = GrootConfig 기본 lerobot/eagle2hg-processor-groot-n1p5
POLICY_EMBODIMENT_TAG=new_embodiment
POLICY_CHUNK_SIZE=16
POLICY_N_ACTION_STEPS=16

# ── 추론 청크 (GR00T action horizon = 16) ────────────────────────────────────
ACTIONS_PER_CHUNK=16

# ── 학습 ─────────────────────────────────────────────────────────────────────
DATASET_VIDEO_BACKEND=             # 비움 = lerobot 기본 (decord 가 이미지에 설치됨)
JOB_NAME=so101_groot_n15_pick_cube
HF_DATASET_REPO_ID=${HF_USER}/so101_sim_pick_cube
# 추론 모델 경로 = 학습 산출 lerobot 체크포인트 (act/smolvla 와 동일 규약).
#   base(nvidia/GR00T-N1.5-3B)는 raw NVIDIA 모델이라 직접 서빙 불가 → 최소 1회 train 후 생성.
#   컨테이너 경로여야 함(호스트 경로 X): policy-server 가 ./outputs→/workspace/outputs 마운트.
POLICY_REPO_ID=/workspace/outputs/train/so101_groot_n15_pick_cube/checkpoints/last/pretrained_model

# ── 그리퍼 command offset (rad) — Option A(절대 기록 규약) 적용 후 0 ──────────
GRIPPER_CMD_OFFSET=0.0

# ── 카메라 키 rename 불필요 ──────────────────────────────────────────────────
# GR00T 는 데이터셋 raw key(top/wrist/front)를 그대로 쓴다.
RENAME_MAP=
