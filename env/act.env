# =============================================================================
# env/act.env — ACT (Action Chunking Transformer) 모델 프로필
#
# 모델 간 값이 달라지는 변수만 담는다. compose 가 .env 위에 이 파일을 겹쳐
# 주입한다(env_file 리스트, 나중 파일이 override). 활성 프로필은 .env 의
# POLICY_PROFILE 로 고른다 (POLICY_PROFILE=act → 이 파일).
#
# ACT = pretrained 베이스 없이 from-scratch 학습 → --policy.type=act 만.
#   (TRAIN_POLICY_TYPE=act 설정 + POLICY_BASE_MODEL_PATH 비움 → entrypoint 가
#    --policy.type=act 만 전달하고 base_model_path 는 건너뛴다.)
#   ACT 는 데이터셋 input_features(top/wrist/front)를 동적으로 읽으므로
#   카메라 키 rename 불필요(RENAME_MAP 비움). chunk_size/n_action_steps 는
#   ACT 기본값(100)을 쓰도록 비워 둔다.
# =============================================================================
POLICY_TYPE=act
TRAIN_POLICY_TYPE=act
POLICY_BASE_MODEL_PATH=
POLICY_TOKENIZER_ASSETS_REPO=
POLICY_EMBODIMENT_TAG=
POLICY_CHUNK_SIZE=
POLICY_N_ACTION_STEPS=
ACTIONS_PER_CHUNK=40
# POLICY_REPO_ID=${HF_USER}/so101_act_pick_cube_v2
POLICY_REPO_ID=/workspace/outputs/train/so101_act_sim_pick_cube_4cube_1024/checkpoints/last/pretrained_model
JOB_NAME=so101_act_pick_cube

# ACT 는 데이터셋 raw key(top/wrist/front)를 그대로 사용 → rename 불필요.
RENAME_MAP=
