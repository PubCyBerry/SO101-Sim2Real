# =============================================================================
# env/groot_n17.env — GR00T-N1.7 (NVIDIA Isaac-GR00T 네이티브) 모델 프로필
#
# 모델 간 값이 달라지는 변수만 담는다. compose 가 .env 위에 이 파일을 겹쳐 주입한다
# (env_file 리스트, 나중 파일이 override). 활성 프로필은 .env 의 POLICY_PROFILE
# (=groot_n17) 로 고른다.
#
# ■ 경로(N1.5 lerobot wrapper 와 근본적으로 다름)
#   N1.7 은 transformers 4.57/py3.10 을 요구해 policy-server:0.5.1(transformers 5.3)
#   과 한 venv 공존 불가 → 별도 'gr00t' 이미지에서 NVIDIA 네이티브로 학습/서빙한다.
#   - 학습/서빙 : gr00t 이미지 (convert→finetune→zmq-server, examples/finetune.sh + run_gr00t_server.py)
#   - 추론 연결 : policy-server 이미지의 'policy-server-groot' 모드(gRPC↔ZMQ bridge)
#                → vla_policy_node 는 코드 불변, 기존 gRPC :8080 컨트랙트 그대로.
#   ※ lerobot-train/policy-server(SmolVLA) 경로는 이 프로필과 무관 (TRAIN_POLICY_TYPE 비움).
# =============================================================================

# ── 정보용 (lerobot-train 미사용 — 네이티브 finetune) ────────────────────────
POLICY_TYPE=groot_n17
TRAIN_POLICY_TYPE=
# vla_policy_node 가 RemotePolicyConfig.policy_type 으로 보내지만 bridge 가 무시한다.
# (실제 모델은 gr00t 이미지가 GROOT_CHECKPOINT 로 로드)

# ── GR00T 네이티브 (gr00t 이미지 entrypoint 가 읽음) ─────────────────────────
GROOT_BASE_MODEL=nvidia/GR00T-N1.7-3B
GROOT_EMBODIMENT_TAG=new_embodiment
GROOT_MODALITY_CONFIG=/host/configs/so101_config.py
GROOT_MODALITY_JSON=/host/configs/so101_modality.json
# finetune 체크포인트(컨테이너 내부 경로 = ../outputs 마운트). examples/finetune.sh 는
# HF Trainer 가 OUTPUT_DIR/checkpoint-<step> 로 저장한다. SAVE_STEPS 기본 1000.
#   검증 마일스톤 = 1k-step → checkpoint-1000. 본학습 시 step·경로 함께 갱신.
GROOT_CHECKPOINT=/host/outputs/train/so101_groot_n17_sim_pick_cube_4cube_1024/checkpoint-80000
GROOT_ZMQ_HOST=127.0.0.1
GROOT_ZMQ_PORT=5555

# ── 추론 청크 (GR00T action horizon = 16) ────────────────────────────────────
ACTIONS_PER_CHUNK=16
POLICY_N_ACTION_STEPS=16

# ── 학습 (검증 마일스톤: 1k-step 스모크) ─────────────────────────────────────
TRAIN_STEPS=1000
BATCH_SIZE=32
JOB_NAME=so101_groot_n17_pick_cube
HF_DATASET_REPO_ID=${HF_USER}/so101_sim_pick_cube
POLICY_REPO_ID=${HF_USER}/so101_groot_n17_pick_cube

# ── 그리퍼 command offset (rad) — sim cuRobo 데이터셋 추론 전용 ───────────────
# SmolVLA 와 동일 데이터(so101_sim_pick_cube)이므로 동일 offset(+0.20). 실기기=0.
# vla_policy_node 가 action 의 그리퍼 target 에 더한다(arm offset=0). grasp 튜닝 대상.
GRIPPER_CMD_OFFSET=0.2

# ── 카메라 키 rename 불필요 ──────────────────────────────────────────────────
# GR00T 는 데이터셋 raw key(top/wrist/front)를 그대로 쓴다. bridge 도 bare 키
# (top/wrist/front)를 GR00T video modality(front/wrist/top)로 매핑하므로 비워 둔다.
RENAME_MAP=
