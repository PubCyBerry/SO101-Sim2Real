# =============================================================================
# env/smolvla.env — SmolVLA 모델 프로필
#
# 모델 간 값이 달라지는 변수만 담는다. compose 가 .env 위에 이 파일을 겹쳐
# 주입한다(env_file 리스트). 활성 프로필은 .env 의 POLICY_PROFILE 로 고른다
# (POLICY_PROFILE=smolvla → 이 파일).
#
# SmolVLA = LeRobot 체크포인트(lerobot/smolvla_base)에서 출발 → --policy.path.
#   (TRAIN_POLICY_TYPE 비움 → entrypoint 가 --policy.path 로 라우팅. type+path 동시 금지.)
#   tokenizer/embodiment/chunk/n_action_steps 는 GR00T 전용이라 비운다.
# =============================================================================
POLICY_TYPE=smolvla
TRAIN_POLICY_TYPE=
POLICY_BASE_MODEL_PATH=lerobot/smolvla_base
POLICY_TOKENIZER_ASSETS_REPO=
POLICY_EMBODIMENT_TAG=
POLICY_CHUNK_SIZE=
POLICY_N_ACTION_STEPS=
ACTIONS_PER_CHUNK=20
POLICY_REPO_ID=${HF_USER}/so101_smolvla_sim_pick_cube   # baseline(A) — HF repo id 또는 컨테이너 경로
# 컨테이너 경로여야 함(호스트 경로 X): policy-server 가 ./outputs→/workspace/outputs 로 마운트.
# last = 최신 체크포인트 자동추적(학습 끝나면 020000). HF push 후엔 taehunkim/so101_smolvla_sim_pick_cube_smooth 로 교체 가능.
# POLICY_REPO_ID=/workspace/outputs/train/so101_smolvla_sim_pick_cube_smooth/checkpoints/last/pretrained_model
JOB_NAME=so101_smolvla_pick_cube

# ── 그리퍼 command offset (rad) — sim cuRobo 데이터셋 추론 전용 ───────────────
# 현재 POLICY_REPO_ID(so101_smolvla_sim_pick_cube)는 **sim cuRobo 데이터**로 학습됐다.
# 그 recorder 는 그리퍼 action 을 Isaac Lab action term 의 use_default_offset(=init
# joint_pos 0.20)을 뺀 pre-offset 값(grip_target − 0.20)으로 기록한다. 학습 env 는 +0.20 을
# 재적용하므로, sim bridge 추론(vla_policy_node)도 그리퍼 target 에 +0.20 을 다시 더해야
# grip_target 에 도달한다. **없으면 그리퍼가 0.20rad 덜 열려 grasp 실패**(eval ever 5%→0%).
# ⚠ **실기기 모델**(절대각 teleop 기록)로 바꾸면 반드시 0 으로 둘 것 — 실기기엔 offset 없음.
GRIPPER_CMD_OFFSET=0.2

# ── 카메라 키 rename (SmolVLA 전용, 필수) ────────────────────────────────────
# lerobot/smolvla_base 의 config 가 input_features 로 observation.images.camera1/2/3
# 를 명시한다. --policy.path 로 fine-tune 하면 이 키가 유지되므로(make_policy 는
# pretrained 의 input_features 를 데이터셋 키로 덮어쓰지 않음), top/wrist/front
# 데이터셋을 camera1/2/3 으로 매핑해 주지 않으면 feature mismatch 로 학습이 실패한다.
#
# 슬롯 순서 = SmolVLA 논문 표준(OBS_IMAGE_1=top, 2=wrist, 3=front)에 맞춤.
# SmolVLA 는 카메라를 이름이 아닌 입력 순서로 구분하므로, 학습 rename 순서와
# 추론 클라이언트의 camera1/2/3 물리 매핑(camera1=top, camera2=wrist, camera3=front)을
# 반드시 동일하게 유지해야 한다(순서가 바뀌면 성능 저하). 공백 없는 compact JSON.
RENAME_MAP={"observation.images.top":"observation.images.camera1","observation.images.wrist":"observation.images.camera2","observation.images.front":"observation.images.camera3"}
