# =============================================================================
# env/groot.env — GR00T N1.5 모델 프로필
#
# 모델 간 값이 달라지는 변수만 담는다. compose 가 .env 위에 이 파일을 겹쳐
# 주입한다(env_file 리스트, 나중 파일이 override). 활성 프로필은 .env 의
# POLICY_PROFILE 로 고른다 (POLICY_PROFILE=groot → 이 파일).
#
# GR00T = NVIDIA native 포맷 베이스 → --policy.type=groot + --policy.base_model_path.
#   (LeRobot 체크포인트가 아니므로 --policy.path 불가. entrypoint 가 TRAIN_POLICY_TYPE
#    설정됨을 보고 type+base_model_path 로 라우팅한다.)
# 토큰 없음 → git 추적 가능.
# =============================================================================
POLICY_TYPE=groot
TRAIN_POLICY_TYPE=groot
POLICY_BASE_MODEL_PATH=nvidia/GR00T-N1.5-3B
POLICY_TOKENIZER_ASSETS_REPO=lerobot/eagle2hg-processor-groot-n1p5
POLICY_EMBODIMENT_TAG=new_embodiment
POLICY_CHUNK_SIZE=8
POLICY_N_ACTION_STEPS=8
ACTIONS_PER_CHUNK=8
POLICY_REPO_ID=${HF_USER}/so101_groot_n15_pick_pen
JOB_NAME=so101_groot_n15_pick_pen

# 카메라 키 rename 불필요(GR00T 는 데이터셋 raw key 인 top/wrist 를 그대로 사용).
# ※ NVIDIA Isaac-GR00T 네이티브 학습(gr00t_finetune.py)의 modality.json / --data-config
#   so100_dualcam(2-카메라 한정)은 이 경로(lerobot GrootPolicy)와 무관하다. lerobot 은
#   input_features 의 VISUAL 피처를 동적으로 읽어 카메라 개수·이름 제약이 없다.
RENAME_MAP=
