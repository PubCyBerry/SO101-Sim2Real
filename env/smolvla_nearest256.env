# Current-physics 4-cube nearest-order 256ep adaptation.
POLICY_TYPE=smolvla
TRAIN_POLICY_TYPE=
POLICY_BASE_MODEL_PATH=/workspace/outputs/train/so101_smolvla_sim_pick_cube_4cube_1024/checkpoints/last/pretrained_model
POLICY_TOKENIZER_ASSETS_REPO=
POLICY_EMBODIMENT_TAG=
POLICY_CHUNK_SIZE=
POLICY_N_ACTION_STEPS=

# Sweep 전 기준값. vla_policy_node ROS parameter로 실행별 override 가능.
ACTIONS_PER_CHUNK=16
CHUNK_SIZE_THRESHOLD=0.5

POLICY_REPO_ID=/workspace/outputs/train/so101_smolvla_sim_pick_cube_nearest_256_adapt/checkpoints/last/pretrained_model
JOB_NAME=so101_smolvla_sim_pick_cube_nearest_256_adapt

# 신규 데이터는 Option A absolute gripper action 계약이다.
GRIPPER_CMD_OFFSET=0.0

RENAME_MAP={"observation.images.top":"observation.images.camera1","observation.images.wrist":"observation.images.camera2","observation.images.front":"observation.images.camera3"}
