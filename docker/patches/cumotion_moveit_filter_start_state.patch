diff --git a/isaac_ros_cumotion_moveit/src/cumotion_move_group_client.cpp b/isaac_ros_cumotion_moveit/src/cumotion_move_group_client.cpp
index 45d1830..dfddad4 100644
--- a/isaac_ros_cumotion_moveit/src/cumotion_move_group_client.cpp
+++ b/isaac_ros_cumotion_moveit/src/cumotion_move_group_client.cpp
@@ -22,6 +22,10 @@
 #include <memory>
 #include <string>
 
+#include <algorithm>
+
+#include "moveit/robot_model/joint_model_group.hpp"
+#include "sensor_msgs/msg/joint_state.hpp"
 #include "moveit_msgs/action/move_group.hpp"
 #include "moveit_msgs/msg/planning_options.hpp"
 #include "rclcpp/rclcpp.hpp"
@@ -69,6 +73,29 @@ void CumotionMoveGroupClient::updateGoal(
   const planning_interface::MotionPlanRequest & req)
 {
   planning_request_ = req;
+
+  // [SO-101 patch] MoveIt request.start_state 는 전체 로봇(arm5+gripper)을 담지만 cuMotion cspace 는
+  // planning group(tool-chain) 관절만이다. 그대로 보내면 INVALID_INITIAL_CSPACE_POSITION(6 vs 5).
+  // start_state.joint_state 를 planning group 의 active 관절로 필터링해 개수를 맞춘다(upstream issue #10).
+  const moveit::core::JointModelGroup * jmg =
+    planning_scene->getRobotModel()->getJointModelGroup(req.group_name);
+  if (jmg != nullptr) {
+    const std::vector<std::string> & active = jmg->getActiveJointModelNames();
+    const sensor_msgs::msg::JointState & js = req.start_state.joint_state;
+    sensor_msgs::msg::JointState filtered;
+    filtered.header = js.header;
+    for (const std::string & jn : active) {
+      auto it = std::find(js.name.begin(), js.name.end(), jn);
+      if (it == js.name.end()) {continue;}
+      size_t i = static_cast<size_t>(std::distance(js.name.begin(), it));
+      filtered.name.push_back(js.name[i]);
+      if (i < js.position.size()) {filtered.position.push_back(js.position[i]);}
+      if (i < js.velocity.size()) {filtered.velocity.push_back(js.velocity[i]);}
+      if (i < js.effort.size()) {filtered.effort.push_back(js.effort[i]);}
+    }
+    planning_request_.start_state.joint_state = filtered;
+  }
+
   planning_scene->getPlanningSceneMsg(planning_scene_);
 }
 
