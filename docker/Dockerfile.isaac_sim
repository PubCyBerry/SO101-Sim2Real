# syntax=docker/dockerfile:1.7
# =============================================================================
# Dockerfile.isaac_sim — Isaac Lab 2.3.2 (Isaac Sim 5.1 통합) + VLA 추론 bridge
#
# Base : nvcr.io/nvidia/isaac-lab:2.3.2 (NVIDIA 공식 통합 이미지)
#        → Isaac Sim 5.1(`/isaac-sim`, repo `_isaac_sim`→`/isaac-sim` 심링크)
#          + Isaac Lab(`/workspace/isaaclab`) + isaaclab_tasks(wheel 내부 source)
#          + torch 2.7.0+cu128 + numpy 1.26.0 + cv2 4.11 전부 사전 설치.
#        ※ `isaac-sim:5.1.0` 단독 이미지는 isaaclab 미포함이고 `pip install isaaclab`
#          가 build-wheel 단계서 실패 → 사용하지 않고 이 통합 이미지를 쓴다.
# Python: `/workspace/isaaclab/isaaclab.sh -p <script>` (번들 isaacsim python 래퍼,
#          USD/pxr·kit 환경을 셋업한 뒤 스크립트 실행). user = root.
# Role : cube_desk + SO-101 시뮬 + `isaacsim.ros2.bridge` + WebRTC livestream(:49100)
#
# ■ 의존성 전략 — docker 자체 관리(uv/pyproject 와 독립)
#   - isaaclab·isaacsim·torch·numpy·cv2 = 베이스 이미지 보유 → 설치/re-pin 안 함
#     (torch 2.7+cu128 덮어쓰면 GPU 깨짐, 베이스 신뢰)
#   - 추가 설치: pyzmq (attention overlay `--attention_overlay` ZMQ SUB 용)
#   - 우리 패키지(sim_to_real·so101_contract) = PYTHONPATH(/workspace/src), 런타임 bind-mount
#
# ■ 빌드/실행 검증 게이트(GPU 필요)
#   - `import sim_to_real`(Gym 등록) + 브리지 livestream(:49100) WebRTC 접속
# =============================================================================

FROM nvcr.io/nvidia/isaac-lab:2.3.2

ENV DEBIAN_FRONTEND=noninteractive

# ── 추가 의존성 (베이스에 없는 것만) ──────────────────────────────────────────
# pyzmq: SmolVLA cross-attention overlay ZMQ SUB. isaaclab·cv2·torch 는 베이스 보유.
# /isaac-sim/python.sh = isaaclab.sh -p 가 쓰는 번들 isaacsim python(동일 site-packages).
RUN /isaac-sim/python.sh -m pip install --no-cache-dir "pyzmq>=27.1.0"

# ── 우리 패키지 (PYTHONPATH, editable 불요) ────────────────────────────────────
# sim_to_real(Gym 등록) + so101_contract(정책 I/O 계약)는 순수 python → bind-mount 된
# /workspace/src 를 PYTHONPATH 에 두면 직접 import. (이미지 IsaacLab 은 /workspace/isaaclab
# 에 있어 /workspace/src 와 sibling — 충돌 없음. /workspace 통째 마운트 금지.)
ENV PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONPATH=/workspace/src

# ── 진입점 ─────────────────────────────────────────────────────────────────────
COPY docker/isaac-sim-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["entrypoint.sh"]
CMD ["bridge"]
