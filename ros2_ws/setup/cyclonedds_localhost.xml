<?xml version="1.0" encoding="UTF-8"?>
<!--
  WSL2 전용 CycloneDDS 설정.
  WSL2 의 loopback(lo) 인터페이스에는 MULTICAST 플래그가 없어
  (ip link show lo => <LOOPBACK,UP,LOWER_UP>) 기본 DDS multicast discovery 가 실패한다.
  → lo 에서 multicast 를 끄고 unicast localhost peer 로 discovery 한다.

  대용량 샘플(카메라 이미지 640x480 bgr8 = 921KB) 전송 튜닝:
  WSL2 loopback 의 작은 소켓 수신 버퍼(rmem_max 기본 208KB) 때문에
  기본 설정으로는 이미지가 단편화 후 수신측에서 드롭되어 0 fps 로 전달된다.
  - MaxMessageSize 65500B : 큰 샘플을 loopback datagram 에 맞게 단편화
  - SocketReceiveBufferSize 10MB : 단편 재조립 버퍼 확보
    (커널 net.core.rmem_max >= 10MB 필요. setup/wsl_ros2_sysctl.conf 참조)
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
      <Watermarks>
        <WhcHigh>2MB</WhcHigh>
      </Watermarks>
    </Internal>
    <Discovery>
      <Peers>
        <Peer address="localhost"/>
      </Peers>
      <ParticipantIndex>auto</ParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
