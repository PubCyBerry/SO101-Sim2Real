<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_cumotion_moveit_config</name>
  <version>0.1.0</version>
  <description>
    SO-101 follower MoveIt 2 + NVIDIA cuMotion(GPU collision-free 계획) 구성 (PATH E).
    so101_moveit_config 의 SRDF/kinematics/joint_limits 를 재사용하고 cuMotion planner
    pipeline 과 cumotion_planner_node(XRDF) 만 추가한다.
  </description>
  <maintainer email="taehun.kim@konantech.com">taehun.kim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>so101_description</exec_depend>
  <exec_depend>so101_moveit_config</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>isaac_ros_cumotion</exec_depend>
  <exec_depend>isaac_ros_cumotion_moveit</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
