<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="so101_control_joint" params="variant joint id">
        <joint name="${joint}">
            <param name="id">${id}</param>
            <!-- follower can be commanded; leader is state-only -->
            <xacro:if value="${variant == 'follower'}">
                <command_interface name="position"/>
                <param name="p_coefficient">16</param>
                <param name="i_coefficient">0</param>
                <param name="d_coefficient">32</param>
                <!-- gripper has additional parameters for motor protection -->
                <xacro:if value="${joint == 'gripper'}">
                    <param name="max_torque_limit">500</param>
                    <param name="protection_current">250</param>
                    <param name="overload_torque">25</param>
                </xacro:if>
            </xacro:if>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

            <param name="return_delay_time">0</param>
            <param name="acceleration">254</param>
        </joint>
    </xacro:macro>

     <xacro:macro name="so101_ros2_control" params="
        variant:='follower'          
        hardware_type:='mock'            
        usb_port:='/dev/ttyUSB0'
        joint_config_file:=''
        system_name:='SO101_SYSTEM'">

        <ros2_control name="${system_name}" type="system">
              <hardware>
                <xacro:if value="${hardware_type == 'mock'}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>

                <xacro:if value="${hardware_type == 'real'}">
                    <plugin>feetech_ros2_driver/FeetechHardwareInterface</plugin>
                    <param name="usb_port">${usb_port}</param>
                    <param name="joint_config_file">${joint_config_file}</param>
                </xacro:if>

                <!-- isaac: Isaac Sim ROS 2 bridge 와 topic 으로 연결. PATH E(cuMotion+ROS, Linux
                     서버 컨테이너) 와 PATH D(WSL2 MoveIt) 공용. controller_manager state_interface 는
                     /isaac_joint_states 에서, command_interface 는 /isaac_joint_commands 로 흐른다
                     (joint_state_broadcaster 의 /follower/joint_states 와 분리해 피드백 루프 방지).
                     Isaac Sim OmniGraph 가 반대편(상태 발행 + 명령 구독→ArticulationController) 담당.
                     sum_wrapped_joint_states: wrist_roll 처럼 ±2π wrap 추적.
                     ⚠ 플러그인 패키지명은 환경 의존: PATH E 컨테이너(so101-cumotion:jazzy)는
                       topic_based_ros2_control/TopicBasedSystem 으로 로드 검증됨(현재 활성). 일부 Jazzy
                       설치(PATH D WSL2)에선 joint_state_topic_hardware_interface/JointStateTopicSystem
                       (pkg: ros-jazzy-joint-state-topic-hardware-interface)로 개명됨 — 환경에 맞춰 교체. -->
                <xacro:if value="${hardware_type == 'isaac'}">
                    <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
                    <param name="joint_commands_topic">/isaac_joint_commands</param>
                    <param name="joint_states_topic">/isaac_joint_states</param>
                    <param name="sum_wrapped_joint_states">true</param>
                </xacro:if>
            </hardware>
            
            <!-- arm joints -->
            <xacro:so101_control_joint variant="${variant}" joint="shoulder_pan"  id="1"/>
            <xacro:so101_control_joint variant="${variant}" joint="shoulder_lift" id="2"/>
            <xacro:so101_control_joint variant="${variant}" joint="elbow_flex"   id="3"/>
            <xacro:so101_control_joint variant="${variant}" joint="wrist_flex"   id="4"/>
            <xacro:so101_control_joint variant="${variant}" joint="wrist_roll"   id="5"/>
            <xacro:so101_control_joint variant="${variant}" joint="gripper"      id="6"/>

        </ros2_control>
    </xacro:macro>
</robot>
