format: xrdf
format_version: 1.0

# SO-101 follower 5-DOF arm 의 cuMotion(cuRobo) XRDF.
# URDF(so101_arm.urdf.xacro, variant=follower) 를 보완: cspace, collision sphere,
# self-collision mask, tool frame.
#
# 주의 — collision sphere 는 보수적 시작값(링크 origin/축 근사)이다.
#   정밀화: Isaac Sim "XRDF Editor"(또는 Lula Robot Description Editor)로 URDF 를
#   로드해 mesh 에 맞춰 sphere 를 시각 편집하거나, RViz 에서 cuMotion 의 sphere
#   MarkerArray(publish_robot_as_spheres) 로 확인 후 조정. (M2 검증 단계)

modifiers:
  - set_base_frame: "base_link"

# self_collision 검사용 기준 자세 — 반드시 self-collision-free 여야 함.
# SRDF "rest" 자세 사용 (검증된 대기 자세).
default_joint_positions:
  shoulder_pan: 0.0
  shoulder_lift: -1.57
  elbow_flex: 1.57
  wrist_flex: 0.75
  wrist_roll: 0.0

# manipulator group = arm 5축 (gripper 는 별도 group, cuMotion 미계획).
cspace:
  joint_names:
    - "shoulder_pan"
    - "shoulder_lift"
    - "elbow_flex"
    - "wrist_flex"
    - "wrist_roll"
  acceleration_limits: [10.0, 10.0, 10.0, 10.0, 10.0]
  jerk_limits: [500.0, 500.0, 500.0, 500.0, 500.0]

tool_frames: ["gripper_frame_link"]

collision:
  geometry: "so101_collision_spheres"
  buffer_distance:
    base_link: 0.005
    shoulder_link: 0.005
    upper_arm_link: 0.005
    lower_arm_link: 0.005
    wrist_link: 0.005
    gripper_link: 0.005
    moving_jaw_so101_v1_link: 0.005

self_collision:
  geometry: "so101_collision_spheres"
  buffer_distance:
    base_link: 0.02
    gripper_link: 0.01
  # SRDF disable_collisions 와 동기 (인접/Never 쌍).
  ignore:
    base_link: ["shoulder_link", "upper_arm_link"]
    shoulder_link: ["upper_arm_link"]
    upper_arm_link: ["lower_arm_link"]
    lower_arm_link: ["wrist_link", "gripper_link", "moving_jaw_so101_v1_link"]
    wrist_link: ["gripper_link", "moving_jaw_so101_v1_link"]
    gripper_link: ["moving_jaw_so101_v1_link"]

# 보수적 sphere 근사 (반지름 ~0.03-0.04m, SO-101 은 소형 암).
# 링크 길이: upper_arm ~0.11m, lower_arm ~0.135m (URDF collision origin 기준).
geometry:
  so101_collision_spheres:
    spheres:
      base_link:
        - center: [0.0, 0.0, 0.03]
          radius: 0.05
      shoulder_link:
        - center: [0.0, 0.0, 0.03]
          radius: 0.04
      upper_arm_link:
        - center: [0.0, 0.0, 0.0]
          radius: 0.035
        - center: [-0.06, -0.02, 0.0]
          radius: 0.035
        - center: [-0.11, -0.028, 0.0]
          radius: 0.035
      lower_arm_link:
        - center: [0.0, 0.0, 0.0]
          radius: 0.032
        - center: [-0.07, 0.0, 0.0]
          radius: 0.030
        - center: [-0.135, 0.005, 0.0]
          radius: 0.030
      wrist_link:
        - center: [0.0, 0.0, 0.0]
          radius: 0.03
      gripper_link:
        - center: [0.0, -0.02, 0.0]
          radius: 0.028
        - center: [0.0, -0.05, 0.0]
          radius: 0.025
      moving_jaw_so101_v1_link:
        - center: [0.0, -0.04, 0.0]
          radius: 0.02
