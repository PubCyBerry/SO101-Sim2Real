#usda 1.0
(
    defaultPrim = "Bowl"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Bowl" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 0
    float physics:mass = 0.25
    bool physics:rigidBodyEnabled = 1
    float physxRigidBody:angularDamping = 8
    bool physxRigidBody:disableGravity = 0
    bool physxRigidBody:enableCCD = 1
    float physxRigidBody:linearDamping = 2
    float physxRigidBody:maxDepenetrationVelocity = 1
    float physxRigidBody:sleepThreshold = 0.0005
    int physxRigidBody:solverPositionIterationCount = 16
    int physxRigidBody:solverVelocityIterationCount = 4
    float physxRigidBody:stabilizationThreshold = 0.0005

    def Scope "Looks"
    {
        def Material "BowlBlue"
        {
            token outputs:surface.connect = </Bowl/Looks/BowlBlue/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.34, 0.78)
                float inputs:metallic = 0
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "BowlFriction" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.1
            float physics:restitution = 0
            float physics:staticFriction = 0.12
            uniform token physxMaterial:frictionCombineMode = "min"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }

