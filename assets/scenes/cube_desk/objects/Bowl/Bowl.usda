#usda 1.0
(
    defaultPrim = "Bowl"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Bowl" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.25
    bool physics:kinematicEnabled = 0
    bool physics:rigidBodyEnabled = 1
    bool physxRigidBody:disableGravity = 0
    bool physxRigidBody:enableCCD = 1
    float physxRigidBody:angularDamping = 8.0
    float physxRigidBody:linearDamping = 2.0
    float physxRigidBody:sleepThreshold = 0.0005
    float physxRigidBody:stabilizationThreshold = 0.0005
    int physxRigidBody:solverPositionIterationCount = 16
    int physxRigidBody:solverVelocityIterationCount = 4
    def Scope "Looks"
    {
        def Material "BowlBlue"
        {
            token outputs:surface.connect = </Bowl/Looks/BowlBlue/Preview.outputs:surface>
            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.65, 0.83, 0.96)
                float inputs:metallic = 0
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }
        def Material "BowlFriction" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 1.8
            float physics:dynamicFriction = 1.5
            float physics:restitution = 0.3
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }
    def Cylinder "Bottom" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        token axis = "Z"
        double height = 0.012
        bool physics:collisionEnabled = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        float physxCollision:torsionalPatchRadius = 0.004
        float physxCollision:minTorsionalPatchRadius = 0.001
        double radius = 0.0325
        rel material:binding = </Bowl/Looks/BowlBlue>
        rel material:binding:physics = </Bowl/Looks/BowlFriction>
        double3 xformOp:translate = (0, 0, 0.006)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
