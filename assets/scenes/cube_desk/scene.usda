#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Scene"
{
    # Generated by scripts/author_pick_cube_scene.py.
    def Scope "Looks"
    {
        def Material "DeskWood"
        {
            token outputs:surface.connect = </Scene/Looks/DeskWood/Preview.outputs:surface>
            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.67, 0.51, 0.32)
                float inputs:metallic = 0
                float inputs:roughness = 0.78
                token outputs:surface
            }
        }
        def Material "DeskMat"
