#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Scene"
{
    def Scope "Looks"
    {
        def Material "DeskWood"
        {
            token outputs:surface.connect = </Scene/Looks/DeskWood/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.67, 0.51, 0.32)
                float inputs:metallic = 0
                float inputs:roughness = 0.78
                token outputs:surface
            }
        }

        def Material "DeskMat"
        {
            token outputs:surface.connect = </Scene/Looks/DeskMat/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.026, 0.032)
                float inputs:metallic = 0
                float inputs:roughness = 0.93
                token outputs:surface
            }
        }

        def Material "Ceiling"
        {
            token outputs:surface.connect = </Scene/Looks/Ceiling/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.86, 0.82)
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                token outputs:surface
            }
        }

        def Material "DeskFriction" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "CubeFriction" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.5
            float physics:restitution = 0
            float physics:staticFriction = 1.8
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }

    def Cube "Ceiling" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Scene/Looks/Ceiling>
        double size = 1
        float3 xformOp:scale = (5, 4, 0.05)
        double3 xformOp:translate = (0.36, 0.355, 2.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "DeskTop" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Scene/Looks/DeskWood>
        rel material:binding:physics = </Scene/Looks/DeskFriction> (
            bindMaterialAs = "weakerThanDescendants"
        )
        bool physics:collisionEnabled = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:minTorsionalPatchRadius = 0.001
        float physxCollision:restOffset = 0
        float physxCollision:torsionalPatchRadius = 0.004
        double size = 1
        float3 xformOp:scale = (1.6, 0.8, 0.025)
        double3 xformOp:translate = (0.36, 0.355, 0.6925)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "DeskLegBackLeft" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Scene/Looks/DeskWood>
        double size = 1
        float3 xformOp:scale = (0.025, 0.025, 0.68)
        double3 xformOp:translate = (-0.36, 0.685, 0.33999999999999997)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "DeskLegBackRight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Scene/Looks/DeskWood>
        double size = 1
        float3 xformOp:scale = (0.025, 0.025, 0.68)
        double3 xformOp:translate = (1.08, 0.685, 0.33999999999999997)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "DeskLegFrontLeft" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Scene/Looks/DeskWood>
        double size = 1
        float3 xformOp:scale = (0.025, 0.025, 0.68)
        double3 xformOp:translate = (-0.36, 0.024999999999999998, 0.33999999999999997)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "DeskLegFrontRight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Scene/Looks/DeskWood>
        double size = 1
        float3 xformOp:scale = (0.025, 0.025, 0.68)
        double3 xformOp:translate = (1.08, 0.024999999999999998, 0.33999999999999997)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "DeskMat" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Scene/Looks/DeskMat>
        rel material:binding:physics = </Scene/Looks/DeskFriction> (
            bindMaterialAs = "weakerThanDescendants"
        )
        bool physics:collisionEnabled = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:minTorsionalPatchRadius = 0.001
        float physxCollision:restOffset = 0
        float physxCollision:torsionalPatchRadius = 0.004
        double size = 1
        float3 xformOp:scale = (0.86, 0.4, 0.004)
        double3 xformOp:translate = (0.08999999999999997, 0.245, 0.707)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Bowl" (
        prepend payload = @./objects/Bowl/Bowl.usd@
    )
    {
        double3 xformOp:translate = (-0.21999999999999997, 0.305, 0.715)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Cube1" (
        prepend payload = @./objects/Cube1/Cube1.usd@
    )
    {
        float xformOp:rotateZ = 20
        double3 xformOp:translate = (-0.14, 0.125, 0.725)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        over "Box" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Scene/Looks/CubeFriction> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }
    }

    def Xform "Cube2" (
        prepend payload = @./objects/Cube2/Cube2.usd@
    )
    {
        float xformOp:rotateZ = -35
        double3 xformOp:translate = (0.13999999999999999, 0.105, 0.725)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        over "Box" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Scene/Looks/CubeFriction> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }
    }

    def Xform "Cube3" (
        prepend payload = @./objects/Cube3/Cube3.usd@
    )
    {
        float xformOp:rotateZ = 50
        double3 xformOp:translate = (-0.10000000000000003, 0.21500000000000002, 0.73)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        over "Box" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Scene/Looks/CubeFriction> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }
    }

    def Xform "Cube4" (
        prepend payload = @./objects/Cube4/Cube4.usd@
    )
    {
        float xformOp:rotateZ = -20
        double3 xformOp:translate = (0.08999999999999997, 0.185, 0.73)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        over "Box" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Scene/Looks/CubeFriction> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }
    }
}

