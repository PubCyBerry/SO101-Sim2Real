#usda 1.0
(
    defaultPrim = "PenCup"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PenCup" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.12
    bool physics:kinematicEnabled = 0
    bool physics:rigidBodyEnabled = 1
    bool physxRigidBody:disableGravity = 0
    bool physxRigidBody:enableCCD = 1
    float physxRigidBody:angularDamping = 4.0
    float physxRigidBody:linearDamping = 0.6
    float physxRigidBody:sleepThreshold = 0.0005
    float physxRigidBody:stabilizationThreshold = 0.0005
    int physxRigidBody:solverPositionIterationCount = 16
    int physxRigidBody:solverVelocityIterationCount = 4
    def Scope "Looks"
    {
        def Material "CupMetal"
        {
            token outputs:surface.connect = </PenCup/Looks/CupMetal/Preview.outputs:surface>
            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.019, 0.023)
                float inputs:metallic = 0.18
                float inputs:roughness = 0.34
                token outputs:surface
            }
        }
        def Material "CupMesh"
        {
            token outputs:surface.connect = </PenCup/Looks/CupMesh/Preview.outputs:surface>
            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.031, 0.033, 0.038)
                float inputs:metallic = 0.22
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }
        def Material "CupFriction" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 1.8
            float physics:dynamicFriction = 1.5
            float physics:restitution = 0
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }
    def Cylinder "Bottom" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
