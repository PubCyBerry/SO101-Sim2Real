#usda 1.0
(
    defaultPrim = "PenBlue"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PenBlue" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.02
    bool physics:kinematicEnabled = 0
    bool physics:rigidBodyEnabled = 1
    bool physxRigidBody:disableGravity = 0
    bool physxRigidBody:enableCCD = 1
    float physxRigidBody:angularDamping = 100.0
    float physxRigidBody:linearDamping = 5.0
    float physxRigidBody:sleepThreshold = 0.05
    float physxRigidBody:stabilizationThreshold = 0.05
    int physxRigidBody:solverPositionIterationCount = 16
    int physxRigidBody:solverVelocityIterationCount = 4
    def Scope "Looks"
    {
        def Material "BlackPlastic"
        {
            token outputs:surface.connect = </PenBlue/Looks/BlackPlastic/Preview.outputs:surface>
            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.016, 0.017, 0.021)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
        def Material "BluePlastic"
        {
            token outputs:surface.connect = </PenBlue/Looks/BluePlastic/Preview.outputs:surface>
            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.19, 0.69)
                float inputs:metallic = 0
                float inputs:roughness = 0.33
                token outputs:surface
            }
        }
        def Material "Steel"
        {
            token outputs:surface.connect = </PenBlue/Looks/Steel/Preview.outputs:surface>
            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.24, 0.25, 0.27)
                float inputs:metallic = 0.72
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
        def Material "PenGripPhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 1.8
            float physics:dynamicFriction = 1.5
            float physics:restitution = 0
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }
    def Capsule "Barrel" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        token axis = "Y"
        double height = 0.118
        bool physics:collisionEnabled = 0
        float physxCollision:contactOffset = 0.0015
        float physxCollision:restOffset = 0
        float physxCollision:torsionalPatchRadius = 0.004
        float physxCollision:minTorsionalPatchRadius = 0.001
        double radius = 0.0077
        rel material:binding = </PenBlue/Looks/BluePlastic>
        rel material:binding:physics = </PenBlue/Looks/PenGripPhysics>
    }
    def Cube "CollisionBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        token visibility = "invisible"
        bool physics:collisionEnabled = 1
        float physxCollision:contactOffset = 0.0015
        float physxCollision:restOffset = 0
        float physxCollision:torsionalPatchRadius = 0.004
        float physxCollision:minTorsionalPatchRadius = 0.001
        double size = 1
        rel material:binding:physics = </PenBlue/Looks/PenGripPhysics>
        double3 xformOp:translate = (0, 0, 0)
        float3 xformOp:scale = (0.0154, 0.118, 0.0154)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cylinder "Grip" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        token axis = "Y"
        double height = 0.025
        bool physics:collisionEnabled = 0
        float physxCollision:contactOffset = 0.0015
        float physxCollision:restOffset = 0
        float physxCollision:torsionalPatchRadius = 0.004
        float physxCollision:minTorsionalPatchRadius = 0.001
        double radius = 0.0081
        rel material:binding = </PenBlue/Looks/BlackPlastic>
        rel material:binding:physics = </PenBlue/Looks/PenGripPhysics>
        double3 xformOp:translate = (0, 0.045, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "BackPlug" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        token axis = "Y"
        double height = 0.009
        bool physics:collisionEnabled = 0
        float physxCollision:contactOffset = 0.0015
        float physxCollision:restOffset = 0
        float physxCollision:torsionalPatchRadius = 0.004
        float physxCollision:minTorsionalPatchRadius = 0.001
        double radius = 0.0079
        rel material:binding = </PenBlue/Looks/BlackPlastic>
        rel material:binding:physics = </PenBlue/Looks/PenGripPhysics>
        double3 xformOp:translate = (0, -0.067, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "AccentRing"
    {
        token axis = "Y"
        double height = 0.003
        double radius = 0.0083
        rel material:binding = </PenBlue/Looks/Steel>
        double3 xformOp:translate = (0, 0.031, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cone "TipSleeve"
    {
        token axis = "Y"
        double height = 0.02
        double radius = 0.007
        rel material:binding = </PenBlue/Looks/BluePlastic>
        double3 xformOp:translate = (0, 0.072, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cone "Nib"
    {
        token axis = "Y"
        double height = 0.007
        double radius = 0.0022
        rel material:binding = </PenBlue/Looks/Steel>
        double3 xformOp:translate = (0, 0.083, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "Clip" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        bool physics:collisionEnabled = 0
        float physxCollision:contactOffset = 0.0015
        float physxCollision:restOffset = 0
        float physxCollision:torsionalPatchRadius = 0.004
        float physxCollision:minTorsionalPatchRadius = 0.001
        double size = 1
        rel material:binding = </PenBlue/Looks/BlackPlastic>
        rel material:binding:physics = </PenBlue/Looks/PenGripPhysics>
        double3 xformOp:translate = (0.0065, -0.02, 0.0065)
        float3 xformOp:scale = (0.002, 0.04, 0.0014)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
