    def Scope "Looks"
    {
        def Material "M_Plate"
        {
            token outputs:mdl:displacement.connect = </root/Looks/M_Plate/Shader.outputs:out>
            token outputs:mdl:surface.connect = </root/Looks/M_Plate/Shader.outputs:out>
            token outputs:mdl:volume.connect = </root/Looks/M_Plate/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                asset inputs:diffuse_texture = @./texture/T_Plate_BC001.png@ (
                    colorSpace = "sRGB"
                )
                bool inputs:enable_ORM_texture = 1
                custom float inputs:metallic_texture_influence = 1
                asset inputs:normalmap_texture = @./texture/T_Plate_N001.png@ (
                    colorSpace = "raw"
                )
                asset inputs:ORM_texture = @./texture/T_Plate_ORM001.png@ (
                    colorSpace = "raw"
                )
                custom float inputs:reflection_roughness_texture_influence = 1
                token outputs:out (
                    renderType = "material"
                )
            }
        }
    }

    def Scope "Physics"
    {
        def Material "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 4
            float physics:staticFriction = 5
        }
    }
}

