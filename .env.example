# =============================================================================
# .env — SO-101 LeRobot / VLA 환경 변수
#   docker  : docker compose --env-file .env -f docker/docker-compose.yaml run --rm <svc> <mode>
#   native  : 경로 A(PATH_A_NATIVE) 의 bash 변수 블록이 이 파일을 그대로 옮긴 형태
#
# 정책 서버(docker, lerobot>=0.5.1)와 인자 계약을 맞춘다. 변수 → CLI 매핑은
# docker/policy-entrypoint.sh / docker/lerobot-entrypoint.sh 의 case 블록 참조.
#
# ┌─ 2-머신 기본 시나리오 ──────────────────────────────────────────────────────┐
# │ Windows 워크스테이션           │  Linux 서버                   │
# │   native uv 또는 docker `lerobot`     │   docker `policy-server`              │
# │   · record    (데이터 수집)           │   · train             (학습)          │
# │   · policy-client (실기기 추론)        │   · policy-server-rtc (추론 서버)      │
# └──────────────────────────────────────┴───────────────────────────────────┘
#   두 머신이 각자 .env 를 둔다. §0 토큰·§1 모델 블록은 양쪽을 동일하게 맞추고,
#   §2 하드웨어/카메라는 클라이언트(이 PC)에서만, §5 학습·§6 서버는 서버에서만 의미.
#
# ■ 처음 설정: cp .env.example .env → §0 토큰 / §1 모델 / §2 포트만 환경에 맞게.
#
# ■ 모델 전환  ⭐ 가장 자주 하는 일
#   §1 의 POLICY_PROFILE 한 줄만 바꾼다 (groot | smolvla | ...).
#   모델별 값은 env/<name>.env 에 있고 compose 가 자동으로 겹쳐 주입.
#   train / prepare-model / policy-server / policy-client 가 모두 같은 프로필 공유.
# =============================================================================


# ── §0. 비밀값 / 계정 ─────────────────────────────────────────────────────────
# HF_TOKEN: https://huggingface.co/settings/tokens (write 권한)
HF_TOKEN=
HF_USER=
# W&B: https://wandb.ai/settings (학습 로깅용, 선택)
WANDB_API_KEY=


# =============================================================================
# §1. 모델 선택  ⭐  — POLICY_PROFILE 한 줄로 결정
# -----------------------------------------------------------------------------
#  모델별 변수(POLICY_TYPE / TRAIN_POLICY_TYPE / POLICY_BASE_MODEL_PATH /
#  POLICY_TOKENIZER_ASSETS_REPO / POLICY_EMBODIMENT_TAG / POLICY_CHUNK_SIZE /
#  POLICY_N_ACTION_STEPS / ACTIONS_PER_CHUNK / POLICY_REPO_ID / JOB_NAME)는
#  env/<name>.env 에 모여 있다. compose 가 ../.env 위에
#  ../env/${POLICY_PROFILE}.env 를 겹쳐 주입한다(env_file 리스트, 나중 파일이 override).
#
#  · 전환   : 이 줄을 바꾸거나  POLICY_PROFILE=smolvla docker compose --env-file .env ... (1회 오버라이드)
#  · 새 모델 : env/<name>.env 작성 후 POLICY_PROFILE=<name>
#  · POLICY_BASE_MODEL_PATH = fine-tune 출발 모델. entrypoint 가 TRAIN_POLICY_TYPE 유무로
#      라우팅: 비움→--policy.path(LeRobot 체크포인트, SmolVLA), 설정→--policy.type+--policy.base_model_path(GR00T).
#      (LeRobot 0.5.x 는 --policy.path 와 --policy.type 동시 지정 금지)
#  · native(경로 A): `set -a; . ./.env; . ./env/<name>.env; set +a` 로 동일 효과.
# =============================================================================
POLICY_PROFILE=groot


# =============================================================================
# §2. 하드웨어 — 직렬 포트 / 기기 타입  (클라이언트 머신: 이 PC)
#   Docker(WSL2): /dev/ttyACM* · Native(Windows): COM*
#   USB 포워딩(usbipd) / 포트 확인은 README·PATH_B 참고.
# =============================================================================
TELEOP_ID=so101_teleop
ROBOT_ID=so101_robot
TELEOP_PORT=/dev/ttyACM0
ROBOT_PORT=/dev/ttyACM1
# calibrate / setup-motors / find-joint-limits 용 타입
ROBOT_TYPE=so101_follower
TELEOP_TYPE=so101_leader
# calibrate / setup-motors 대상: robot(팔로워) | teleop(리더)
CALIBRATE_TARGET=robot


# =============================================================================
# §3. 카메라  (클라이언트 머신: 이 PC)
#   Docker: /dev/video* (짝수=캡처, 홀수=메타) · Native: OpenCV index(0,1,2...)
# =============================================================================
# 활성 카메라 부분집합 (콤마 구분, 순서 보존). 단일: wrist / 3개: wrist,front,top
ENABLED_CAMERAS=wrist,front,top
# 전면부 시점
FRONT_CAM_PORT=2
FRONT_CAM_META_PORT=/dev/video1
# 손목 시점
WRIST_CAM_PORT=1
WRIST_CAM_META_PORT=/dev/video3
# 탑뷰(선택). 미사용 시 비우면 docker-compose 가 /dev/null 폴백 마운트.
TOP_CAM_PORT=0
TOP_CAM_META_PORT=/dev/video5
# 해상도 / FPS / fourcc  (확인: v4l2-ctl --list-formats-ext)
CAM_WIDTH=640
CAM_HEIGHT=480
CAM_FPS=25
# UVC warmup 대기(초). "Timed out waiting for frame" 시 늘릴 것.
CAM_WARMUP_S=5
CAM_FOURCC=MJPG
# native 경로 참고용 인라인 dict (docker 는 entrypoint 가 ENABLED_CAMERAS 로 빌드)
CAMERAS="{
    wrist: {type: opencv, index_or_path: ${WRIST_CAM_PORT}, width: ${CAM_WIDTH}, height: ${CAM_HEIGHT}, fps: ${CAM_FPS}, fourcc: ${CAM_FOURCC}},
    front: {type: opencv, index_or_path: ${FRONT_CAM_PORT}, width: ${CAM_WIDTH}, height: ${CAM_HEIGHT}, fps: ${CAM_FPS}, fourcc: ${CAM_FOURCC}},
    top: {type: opencv, index_or_path: ${TOP_CAM_PORT}, width: ${CAM_WIDTH}, height: ${CAM_HEIGHT}, fps: ${CAM_FPS}, fourcc: ${CAM_FOURCC}},
}"


# =============================================================================
# §4. 데이터 수집 / 재생 / 시각화  (클라이언트 머신: record / replay / dataset-viz)
# =============================================================================
SINGLE_TASK="pick up the pen and place it in the holder"
# 데이터셋 HF Hub ID '{user}/{name}' — record / replay / dataset-viz 공통
HF_DATASET_REPO_ID=${HF_USER}/so101_pick_pen
# 로컬 저장 루트 (공백 없는 경로 권장)
DATASET_ROOT=datasets/pick_pen
NUM_EPISODES=10
EPISODE_TIME_S=60
RESET_TIME_S=10
RECORD_FPS=30
PUSH_TO_HUB=true
# replay / dataset-viz 대상 에피소드 (0-based)
EPISODE_INDEX=0
# dataset-viz: local(내부 뷰어) | distant(WebSocket, `rerun ws://HOST:VIZ_WS_PORT`)
VIZ_MODE=local
VIZ_WS_PORT=9087
# ── rerun viewer (teleop / record) ──
DISPLAY_DATA=true
DISPLAY_IP=null
DISPLAY_PORT=null
# 녹화 인코딩
STREAM_DATA=true
ENCODER_THREADS=2
# 추가 인자 (공백 구분)
TELEOP_EXTRA_ARGS="
    --display_data=${DISPLAY_DATA}
    --display_ip=${DISPLAY_IP}
    --display_port=${DISPLAY_PORT}
    --display_compressed_images=true
"
RECORD_EXTRA_ARGS="
    --display_data=${DISPLAY_DATA}
    --display_ip=${DISPLAY_IP}
    --display_port=${DISPLAY_PORT}
    --dataset.root=${DATASET_ROOT}
    --dataset.vcodec=auto
    --dataset.streaming_encoding=${STREAM_DATA}
    --dataset.encoder_threads=${ENCODER_THREADS}
    --play_sounds=false
"
REPLAY_EXTRA_ARGS=


# =============================================================================
# §5. 학습  (서버 머신: policy-server train)  — 모델 식별 값은 §1 에서 옴
# =============================================================================
BATCH_SIZE=16
TRAIN_STEPS=10000
# OUTPUT_DIR 미설정 시 entrypoint 가 outputs/train/${JOB_NAME}(프로필) 로 자동 설정.
# 직접 고정하려면 주석 해제: OUTPUT_DIR=outputs/train/my_run
DEVICE=cuda
WANDB_ENABLE=true
# LeRobot 0.5.1 dataset 비디오 디코더: torchcodec | pyav | video_reader
DATASET_VIDEO_BACKEND=torchcodec
# policy config 에 video_backend 필드가 있는 정책용. 보통 비움.
POLICY_VIDEO_BACKEND=
# 데이터셋 카메라 키 → 정책 입력 키 rename (JSON, 비우면 생략).
# SmolVLA 는 lerobot 이 wrist→camera1 등으로 자동 생성하므로 보통 비움.
# GR00T 는 raw key 를 직접 읽으므로 비움.
RENAME_MAP=
# 추가 lerobot-train 인자
TRAIN_EXTRA_ARGS="
"
# ── 속도 최적화 ──
NUM_WORKERS=8
# torch.compile (true/false). 10K+ steps 에서 ~20-30%↑, 첫 스텝 컴파일 비용.
# ※ GR00T(TRAIN_POLICY_TYPE=groot)는 compile_model config 필드가 없어
#   entrypoint 가 true 라도 자동으로 건너뛴다. SmolVLA 등에서만 효과.
COMPILE_MODEL=false
# reduce-overhead(안정) | max-autotune(최대 속도, 컴파일 김)
COMPILE_MODE=reduce-overhead
# 사용 GPU 수. 2+ 면 accelerate launch DDP 자동 전환.
NUM_PROCESSES=1
# 혼합 정밀도: bf16(Ampere+ 권장) | fp16(구형) | no
MIXED_PRECISION=bf16
# prepare-model: 기본 다운로드 대상은 POLICY_REPO_ID(§1). revision/추가인자만 여기.
MODEL_REVISION=main
PREPARE_MODEL_EXTRA_ARGS=


# =============================================================================
# §6. 추론 서버  (서버 머신: policy-server / policy-server-rtc)
#   서버는 policy-agnostic — 모델은 클라이언트가 SendPolicyInstructions 로 주입.
#   보안: pickle RCE(CVE-2026-25874). 외부 노출 금지, SSH 터널/방화벽 권장.
# =============================================================================
POLICY_SERVER_HOST=0.0.0.0
POLICY_SERVER_PORT=8080
POLICY_FPS=30
INFERENCE_LATENCY=0.033
OBS_QUEUE_TIMEOUT=2
POLICY_SERVER_EXTRA_ARGS=
# ── RTC (policy-server-rtc · scripts/policy_server_rtc.py) ──
# compose 의 policy-server command 가 "policy-server-rtc" 일 때 사용.
# flow-matching 정책(SmolVLA/Pi0/Pi0.5)에 guidance 적용. GR00T 는 RTC 미지원이라
# 표준 추론으로 fallback(무해) — 클라이언트는 변경 없이 동일하게 접속.
RTC_EXECUTION_HORIZON=10
RTC_MAX_GUIDANCE_WEIGHT=10.0
RTC_PREFIX_ATTENTION_SCHEDULE=EXP


# =============================================================================
# §7. 추론 클라이언트  (클라이언트 머신: lerobot policy-client / native shim)
#   모델 종류·체크포인트(POLICY_TYPE / POLICY_REPO_ID / ACTIONS_PER_CHUNK)는 §1 프로필에서 옴.
# =============================================================================
# 서버 주소. 같은 호스트=127.0.0.1:8080, 원격=<server_ip>:8080 (또는 SSH 터널 시 127.0.0.1:8080)
POLICY_SERVER_ADDRESS=127.0.0.1:8080
# 서버 측 정책 디바이스 / 클라이언트 측 후처리 디바이스
POLICY_DEVICE=cuda
CLIENT_DEVICE=cpu
# 자연어 task instruction
TASK="pick up the pen and place it in the holder"
# 큐가 이 비율 미만이면 새 청크 요청 (0~1)
CHUNK_SIZE_THRESHOLD=0.5
# 청크 결합 함수: weighted_average | latest_only | average | conservative
AGGREGATE_FN_NAME=weighted_average
# 컨트롤 루프 FPS 는 §6 의 POLICY_FPS 를 클라이언트도 공유한다(서버·클라 동일 제어율).
# 굳이 다르게 하려면 POLICY_CLIENT_EXTRA_ARGS=--fps=N 로 오버라이드.
POLICY_CLIENT_EXTRA_ARGS=
